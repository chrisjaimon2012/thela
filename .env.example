# Copy to .dev.vars for local development. NEVER commit the real file.
# In production these are Worker secrets: `wrangler secret put <NAME>`.

# --- First-run protection -----------------------------------------------------
# A freshly deployed shop has no admin password, so /admin/setup is reachable by
# anyone who finds the URL. Set this BEFORE the first deploy; setup refuses to
# run without it.
ADMIN_SETUP_TOKEN=

# Signs admin sessions. Any long random string.
SESSION_SECRET=

# --- Payments -----------------------------------------------------------------
# Nothing secret is needed for UPI: the VPA is public by nature and lives in
# the settings table. Funds never touch this software.
#
# Only set these if you enable a conventional gateway adapter instead.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Shipping -----------------------------------------------------------------
# Delhivery One: Settings > API Setup > Request Live API Token.
#
# WARNING: generating a new token kills the old one IMMEDIATELY, and the new
# one is revealed once, for five minutes. Clicking that button out of curiosity
# on a live shop breaks dispatch with no obvious cause.
DELHIVERY_TOKEN=
DELHIVERY_BASE=https://staging-express.delhivery.com

# --- Outbound email -----------------------------------------------------------
# Resend free tier: 3,000/month, 100/day, custom domain with DKIM.
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@example.com
ORDER_REPLY_TO=hello@example.com

# --- Alerting -----------------------------------------------------------------
# Where the dead-man's switch shouts. This is the address that finds out when
# payments stopped confirming or the carrier wallet ran dry.
OPS_ALERT_EMAIL=
