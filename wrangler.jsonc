{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thela",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // `main` and `assets` are deliberately absent: the Astro Cloudflare adapter
  // generates the Worker entry and wires the asset directory itself. Setting
  // them here makes `astro build` fail, because the entry does not exist until
  // after the build it is trying to configure.
  //
  // Static assets are uploaded separately from the Worker script, so they do
  // not count against the 3 MiB gzipped bundle limit and requests to them are
  // free and unlimited. That is what keeps the whole shop inside the free tier.

  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thela",
      // Omitted on purpose. The Deploy to Cloudflare button creates the
      // database and writes the real id into the copy of this file in your
      // repo. Deploying by hand instead? Run `wrangler d1 create thela` and
      // paste the id it prints as "database_id".
      //
      // Do NOT write "" and do not omit it. Miniflare asserts the id is
      // truthy, so `astro dev` dies at the first request — with a bare falsy
      // -value assertion from deep inside its bundle in the empty case, and a
      // misleading dep-optimizer error in the absent case. Both cost an hour
      // to diagnose. A placeholder is the only form that serves local dev and
      // the installer at once.
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],

  // R2 IS NOT DECLARED HERE, AND THAT IS DELIBERATE.
  //
  // R2 has a real free tier — 10 GB, 1M Class A, 10M Class B, no egress charge
  // — but the account must carry an R2 subscription before a bucket can exist,
  // and Cloudflare's own get-started page tells you to "complete the checkout
  // flow" to add one. That means a card. A volunteer running a church stall in
  // Maharashtra may not have an international card at all, and a shop that
  // cannot be installed without one is not the shop this project is for.
  //
  // So a default install has no object storage. Product images are absent
  // rather than broken, and the logo degrades to the shop name as text. The
  // admin explains the trade and links to the checkout flow, and the moment a
  // shopkeeper opts in they paste this block back:
  //
  //   "r2_buckets": [
  //     { "binding": "MEDIA",  "bucket_name": "thela-media"  },
  //     { "binding": "LABELS", "bucket_name": "thela-labels" }
  //   ],
  //
  // Then serve MEDIA from an R2 CUSTOM DOMAIN, never through a Worker route.
  // Piping images through the Worker is the one mistake that turns a
  // comfortable free tier into an overage, and Cloudflare's terms separately
  // reserve the right to limit free-plan CDN use for "a disproportionate
  // percentage of pictures".

  // Native rate limiting, so we do not need Durable Objects in v1.
  "ratelimits": [
    { "name": "CHECKOUT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "UTR_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // NO CRONS HERE. `scheduled` cannot be attached to the storefront: the Astro
  // adapter builds its Worker entry as `{ fetch: handle }` from a virtual
  // module we do not own, so there is nowhere to put the handler. A cron
  // declared here would fire against a Worker that cannot answer it.
  //
  // They live in workers/ops/wrangler.jsonc alongside the code that runs them.
  // See ADR-0023.

  "vars": {
    "SHOP_ENV": "production",
    // The address bank alerts are forwarded to. Cloudflare Email Routing must
    // be configured to send this address to this Worker.
    "BANK_ALERT_ADDRESS": "pay@example.com"
  }

  // Secrets — set with `wrangler secret put`, never committed:
  //   ADMIN_SETUP_TOKEN     gates first-run setup (see README, "first-run race")
  //   DELHIVERY_TOKEN       carrier API token
  //   RESEND_API_KEY        outbound transactional email
  //   SESSION_SECRET        admin session signing
}
