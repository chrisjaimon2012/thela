---
/**
 * The admin shell.
 *
 * Its styling is FROZEN and never reads `theme.*`. A shopkeeper who picks an
 * unreadable accent must not be locked out of the page where they would fix it
 * — and more prosaically, the admin is a tool, not a shopfront, so it should
 * look the same in every shop and be recognisable in a screenshot when someone
 * asks for help.
 */
interface Props {
  title: string;
  /** Rendered under the heading. One sentence, no marketing. */
  intro?: string;
}

const { title, intro } = Astro.props;
const admin = Astro.locals.admin;
const path = Astro.url.pathname;

const nav = [
  { href: '/admin', label: 'Orders' },
  { href: '/admin/payments', label: 'Payments' },
  { href: '/admin/settings', label: 'Settings' },
];

// Never cached, never indexed. Everything here is one shop's private business.
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root {
        --ink: #1a1c20; --ink-2: #5f6672; --paper: #ffffff; --sunk: #f6f7f8;
        --line: #e2e5e9; --accent: #1e5aa8; --on-accent: #ffffff;
        --warn: #8a5300; --warn-bg: #fff8e6;
        --bad: #a11b1b; --bad-bg: #fdf0f0;
        --good: #1c6b3f;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #e8eaed; --ink-2: #9aa3af; --paper: #16181c; --sunk: #1d2025;
          --line: #2b2f36; --accent: #6ea8f0; --on-accent: #10131a;
          --warn: #e3b25a; --warn-bg: #2a2214;
          --bad: #f08a8a; --bad-bg: #2a1717;
          --good: #6fc79a;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); }
      h1 { font-size: 1.35rem; margin: 0 0 .2rem; letter-spacing: -.015em; }
      h2 { font-size: 1rem; margin: 2rem 0 .6rem; }
      .wrap { max-width: 980px; margin: 0 auto; padding: 0 1rem; }
      .muted { color: var(--ink-2); }
      .small { font-size: .87rem; }
      .num { font-variant-numeric: tabular-nums; }

      header.admin { border-bottom: 1px solid var(--line); background: var(--sunk); }
      header.admin .bar { display: flex; gap: 1.25rem; align-items: center; padding: .7rem 0; flex-wrap: wrap; }
      header.admin .who { margin-left: auto; font-size: .85rem; color: var(--ink-2); }
      nav a { text-decoration: none; color: var(--ink-2); font-weight: 500; padding: .2rem 0; }
      nav a[aria-current] { color: var(--ink); box-shadow: inset 0 -2px var(--accent); }

      main { padding: 1.75rem 0 4rem; }

      table { width: 100%; border-collapse: collapse; font-size: .93rem; }
      th { text-align: left; font-size: .78rem; text-transform: uppercase;
           letter-spacing: .06em; color: var(--ink-2); font-weight: 600;
           padding: .4rem .6rem; border-bottom: 1px solid var(--line); }
      td { padding: .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
      tr:hover td { background: var(--sunk); }

      .pill { display: inline-block; font-size: .74rem; font-weight: 600;
              text-transform: uppercase; letter-spacing: .05em;
              padding: .15rem .45rem; border-radius: 3px; background: var(--sunk);
              color: var(--ink-2); border: 1px solid var(--line); }
      .pill.good { color: var(--good); }
      .pill.warn { color: var(--warn); background: var(--warn-bg); }
      .pill.bad { color: var(--bad); background: var(--bad-bg); }

      button, .btn {
        font: inherit; font-weight: 500; border: 1px solid var(--accent);
        background: var(--accent); color: var(--on-accent);
        padding: .5rem .9rem; border-radius: 4px; cursor: pointer;
        text-decoration: none; display: inline-block;
      }
      button.quiet, .btn.quiet { background: transparent; color: var(--ink); border-color: var(--line); }
      button[disabled] { opacity: .5; cursor: not-allowed; }
      input, select, textarea {
        font: inherit; padding: .45rem .55rem; border: 1px solid var(--line);
        border-radius: 4px; background: var(--paper); color: var(--ink); width: 100%;
      }
      label { display: block; font-size: .87rem; font-weight: 500; margin-bottom: .9rem; }
      label .hint { display: block; font-weight: 400; color: var(--ink-2); font-size: .84rem; margin-top: .15rem; }
      label input, label select, label textarea { margin-top: .3rem; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .note { border: 1px solid var(--line); border-left: 3px solid var(--accent);
              border-radius: 4px; padding: .7rem .9rem; margin: 0 0 1.25rem; }
      .note.warn { border-left-color: var(--warn); background: var(--warn-bg); }
      .note.bad { border-left-color: var(--bad); background: var(--bad-bg); }
      .empty { padding: 3rem 1rem; text-align: center; color: var(--ink-2); }
    </style>
  </head>

  <body>
    <header class="admin">
      <div class="wrap bar">
        <strong>{Astro.locals.settings.shopName}</strong>
        <nav style="display:flex;gap:1rem">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.href === path || (n.href !== '/admin' && path.startsWith(n.href)) ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
        {admin && (
          <span class="who">
            {admin.email}
            {admin.via === 'access' && ' · via Access'}
            {' · '}
            <a href="/admin/logout">Sign out</a>
          </span>
        )}
      </div>
    </header>

    <main class="wrap">
      <h1>{title}</h1>
      {intro && <p class="muted" style="margin:0 0 1.5rem">{intro}</p>}
      <slot />
    </main>
  </body>
</html>
