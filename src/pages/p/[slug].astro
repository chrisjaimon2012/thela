---
import Base from '../../layouts/Base.astro';
import { getProduct } from '../../lib/catalogue';
import { mediaUrl, countryName } from '../../lib/settings';
import { priceFormatter } from '../../lib/money';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const db = env.DB;

const product = slug ? await getProduct(db, slug) : null;
if (!product) return new Response('Not found', { status: 404 });

const settings = Astro.locals.settings;
const price = priceFormatter(settings);

const cheapest = Math.min(...product.variants.map((v) => v.priceMinor));
const anyAvailable = product.variants.some((v) => v.available);
const parcel = product.variants.find((v) => v.lenMm && v.widMm);

// Legal Metrology (Packaged Commodities) Rules 2011 rule 6(10) is an Indian
// statute, so its declarations render only for an Indian shop. A Lyon studio
// showing "Net quantity 1 N" would be noise, not compliance.
const showPackagedDeclarations = settings.country === 'IN';

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600',
);
---

<Base title={product.title} description={product.summary ?? undefined}>
  <article style="display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));padding:2rem 0">
    <div>
      {product.imageKeys.length > 0 ? (
        product.imageKeys.map((key, i) => (
          <img
            src={mediaUrl(settings, key)}
            alt={product.title}
            width="900" height="1350"
            loading={i === 0 ? 'eager' : 'lazy'}
            style="border-radius:3px;margin-bottom:.75rem"
          />
        ))
      ) : (
        <div class="thumb" style="aspect-ratio:2/3;background:var(--line);border-radius:3px"></div>
      )}
    </div>

    <div class="measure">
      <h1 style="margin:0 0 .35rem;font-size:1.6rem;letter-spacing:-.015em">{product.title}</h1>
      <p class="price" style="font-size:1.15rem;margin:0 0 1rem">{price(cheapest)}</p>

      {product.summary && <p class="muted">{product.summary}</p>}

      {anyAvailable ? (
        <form method="POST" action="/api/cart/add" style="display:grid;gap:.75rem;max-width:22rem;margin:1.5rem 0">
          <input type="hidden" name="slug" value={product.slug} />

          {/*
            One select per axis the vendor declared, labelled with their own
            word for it. Nothing here knows what a frame or a sleeve length is.
          */}
          {product.axes.map((axis) => (
            <label>
              {axis.name}
              <select name={`option${axis.position}`} required style="display:block;width:100%;margin-top:.25rem">
                {axis.values.map((v) => <option value={v}>{v}</option>)}
              </select>
            </label>
          ))}

          <button type="submit">Add to cart</button>
        </form>
      ) : (
        <p class="sold-out" style="margin:1.5rem 0">Sold out.</p>
      )}

      {product.bodyMd && (
        <div class="muted" style="white-space:pre-wrap">{product.bodyMd}</div>
      )}

      <dl style="margin-top:2rem;font-size:.87rem;display:grid;grid-template-columns:auto 1fr;gap:.3rem 1rem">
        {showPackagedDeclarations && (
          <>
            <dt class="muted">Net quantity</dt><dd style="margin:0">1 N</dd>
            {parcel && (
              <>
                <dt class="muted">Dimensions</dt>
                <dd style="margin:0">{parcel.lenMm / 10} × {parcel.widMm / 10} cm</dd>
              </>
            )}
          </>
        )}
        {settings.legalName && (<><dt class="muted">Packed by</dt><dd style="margin:0">{settings.legalName}</dd></>)}
        {settings.country && (
          <>
            <dt class="muted">Country of origin</dt>
            <dd style="margin:0">{countryName(settings)}</dd>
          </>
        )}
        {settings.supportEmail && (<><dt class="muted">Consumer care</dt><dd style="margin:0">{settings.supportEmail}</dd></>)}
      </dl>
    </div>
  </article>
</Base>
