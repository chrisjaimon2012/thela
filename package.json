{
  "name": "thela",
  "version": "0.1.0-dev",
  "private": true,
  "description": "A shop that runs on Cloudflare's free tier, takes UPI straight to your own bank account, and dispatches parcels without anyone clicking a button.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply thela --local",
    "db:migrate": "wrangler d1 migrations apply thela --remote",
    "db:seed:local": "wrangler d1 execute thela --local --file=./seeds/dev.sql",
    "bank:selftest": "node ./scripts/bank-selftest.mjs",
    "test": "vitest run && npm run test:schema",
    "test:schema": "sqlite3 :memory: \".read migrations/0001_init.sql\" \".read tests/invariants.test.sql\"",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "astro": "^7.2.1",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  },
  "allowScripts": {
    "workerd@1.20260804.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
