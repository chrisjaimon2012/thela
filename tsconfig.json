{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".wrangler"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-pool-workers/types"
    ]
  }
}
